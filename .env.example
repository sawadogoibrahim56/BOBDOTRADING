# ═══════════════════════════════════════════════════════════════
# BTF – Variables d'Environnement – COPIER EN .env
# ⚠️  Ne jamais committer .env sur Git !
# ═══════════════════════════════════════════════════════════════

# SUPABASE
DATABASE_URL=postgresql+asyncpg://postgres:MOT_DE_PASSE@db.XXXX.supabase.co:5432/postgres
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# JWT (generer: python -c "import secrets; print(secrets.token_hex(64))")
JWT_SECRET_KEY=MINIMUM_64_CARACTERES_ALEATOIRES

# CHIFFREMENT API KEYS (generer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=CLE_FERNET_BASE64

# ADMIN
ADMIN_ALLOWED_IPS=0.0.0.0
ADMIN_PIN_CODE=123456
ADMIN_ALERT_EMAIL=admin@btf.bf
ADMIN_PHONE=+22670000000

# PAIEMENTS MOBILE MONEY (jamais en base de donnees !)
ORANGE_MONEY_NUMBER=+22670000000
WAVE_NUMBER=+22670000001
MOOV_MONEY_NUMBER=+22670000002

# EMAIL SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tonemail@btf.bf
SMTP_PASSWORD=MOT_DE_PASSE_SMTP
FROM_EMAIL=noreply@btf.bf

# SMS TWILIO (optionnel)
TWILIO_ACCOUNT_SID=ACxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ENVIRONNEMENT
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://btf.bf,http://localhost:3000
